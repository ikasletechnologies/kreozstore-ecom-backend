# App
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (docker/docker-compose.yml maps Postgres to host port 5434 in local dev —
# this host already runs other projects' Postgres containers on 5432 and 5433)
DATABASE_URL=postgresql://ecommerce:changeme@localhost:5434/ecommerce_dev?schema=public

# JWT — generate a dev keypair with `npm run keys:generate` and paste the two lines it
# prints below (already newline-escaped for a single-line .env value). Never commit real keys.
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=ecommerce-platform

# Redis (mapped to host port 6380 in local dev, see docker/docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=changeme

# Uploads
UPLOAD_ROOT_PATH=D:/E-commerce/uploads
UPLOAD_MAX_IMAGE_SIZE_MB=5
UPLOAD_MAX_DOC_SIZE_MB=10

# SMTP / Nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Enterprise Store
SMTP_FROM_EMAIL=no-reply@example.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rate limiting / security
THROTTLE_TTL=60
THROTTLE_LIMIT=100
BCRYPT_SALT_ROUNDS=12

# Seed script (prisma/seed.ts) — printed password on first run only, never stored here
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Logging
LOG_LEVEL=info
